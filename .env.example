# Server
LANGPRED_HOST=0.0.0.0
LANGPRED_PORT=7187
LANGPRED_DATABASE_URL=sqlite:///./langpred.db
LANGPRED_TRAIN_INTERVAL_SECONDS=300
LANGPRED_TRAIN_ON_EVENT=0
LANGPRED_LOG_LEVEL=info

# Optional: mirror every ingestion event to a Langfuse instance so you keep the dashboard
# LANGPRED_MIRROR_TO=https://cloud.langfuse.com

# SDK
LANGFUSE_HOST=http://localhost:7187
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
# Native langpred env vars (fall back to LANGFUSE_* if unset)
# LANGPRED_HOST=http://localhost:7187
# LANGPRED_PUBLIC_KEY=pk-lf-local
# LANGPRED_SECRET_KEY=sk-lf-local
